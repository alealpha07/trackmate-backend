DATABASE_URL="file:./data/dev.db"
SESSION_SECRET="SECRET"
COOKIE_SECRET="SECRET"
PORT=3000
PUBLIC_URL="https://backend.trackmate.alpha-hub.net"
ANDROID_PACKAGE_NAME="com.example.trackmate"
ANDROID_CERT_SHA256="EE:D8:46:B1:D1:65:6D:62:B5:D9:E3:21:0B:F1:91:E2:2A:54:F7:D5:2C:E2:9E:B1:F3:D4:A0:87:4B:88:D9:6F"
# comma separated, tried in order
OVERPASS_ENDPOINT="https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter"
OSM_CACHE_DIR="./cache/osm"
# tile cache limits (days, MB)
OSM_CACHE_TTL_DAYS=30
OSM_CACHE_MAX_MB=2048
DEM_CACHE_DIR="./cache/dem"
DEM_CACHE_TTL_DAYS=365
DEM_CACHE_MAX_MB=2048
# turn-by-turn instructions, the public FOSSGIS server allows at most 1 request a second
VALHALLA_URL="https://valhalla1.openstreetmap.de"
# sent as X-Client-Id, defaults to the PUBLIC_URL host
VALHALLA_CLIENT_ID="backend.trackmate.alpha-hub.net"
INSTRUCTIONS_CACHE_DIR="./cache/instructions"
INSTRUCTIONS_CACHE_TTL_DAYS=30
INSTRUCTIONS_CACHE_MAX_MB=1024
STADIA_API_KEY=""